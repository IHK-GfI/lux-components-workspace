{
  "customSyntax": "postcss-scss",
  "ignoreFiles": ["src/base-templates/tokens/_deprecated-aliases.scss", "src/theme-*/_deprecated-aliases-theme.scss"],
  "rules": {
    "custom-property-pattern": [
      "^(lux-(primitive|base|component)-[a-z0-9]+(-[a-z0-9]+)*|mat-[a-z0-9]+(-[a-z0-9]+)*)$",
      {
        "message": "Eigene Tokens heißen --lux-{primitive|base|component}-… (Kleinbuchstaben, Ziffern, Bindestriche), erlaubt sind außerdem Material-Tokens --mat-…. Alte Namen (--lux-theme-* usw.) nur in den Legacy-Dateien unter \"overrides\"."
      }
    ]
  },
