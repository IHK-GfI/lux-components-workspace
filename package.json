{
  "name": "@ihk-gfi/lux-components-workspace",
  "version": "21.11.0",
  "license": "IHK-GfI Open-Source-Lizenz",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch:components": "ng test lux-components-lib",
    "storybook": "npm run build --workspace=projects/lux-components-theme && ng run lux-components-lib:storybook",
    "build-storybook": "npm run build --workspace=projects/lux-components-theme && ng run lux-components-lib:build-storybook",
    "lint": "ng lint",
    "format": "npx prettier --write \"projects/**/*.{ts,html,scss,json}\"",
    "smoketest": "npm run pack:all && npm run test:all",
    "pack:demo": "ng build demo-app",
    "pack:components": "ng build lux-components-lib",
    "pack:theme": "npm run pack --workspace=projects/lux-components-theme",
    "pack:updater": "npm run pack --workspace=projects/lux-components-update",
    "pack:all": "npm run util:delete-dist && npm run pack:theme && npm run pack:components && npm run pack:updater && npm run pack:demo",
    "release:prepare": "node scripts/release.js prepare",
    "release:finish": "node scripts/release.js finish",
    "release:updater": "node scripts/release.js updater",
    "start:demo": "npm run util:check-demo-conditions && npm run start",
    "start:dev": "npm run util:delete-dist && run-p watch:components watch:theme util:wait-and-start-demo",
    "tar:components": "npm run pack:components && cd dist/lux-components-lib && npm pack && cd ../..",
    "tar:theme": "npm run pack:theme && cd dist/theme && npm pack && cd ../..",
    "tar:updater": "npm run pack:updater && cd dist/updater && npm pack && cd ../..",
    "tar:all": "npm run util:delete-dist && npm run tar:theme && npm run tar:components && npm run tar:updater",
    "test:all": "npm run test:components && npm run test:demo && npm run test:theme && npm run test:updater && npm run test:release-scripts",
    "test:components": "ng lint lux-components-lib && npm run test:cycles && ng test lux-components-lib --watch=false --coverage=true",
    "test:cycles": "npx -y madge@8.0.0 --circular --no-spinner projects/lux-components-lib",
    "test:demo": "ng lint demo-app",
    "test:theme": "npm run smoketest --workspace=projects/lux-components-theme",
    "test:updater": "npm run smoketest --workspace=projects/lux-components-update",
    "test:release-scripts": "node --test scripts/release-lib.test.js",
    "util:check-demo-conditions": "node scripts/check-demo-conditions.js",
    "util:move-files": "node scripts/move-files.js",
    "util:clean-all": "npm run util:delete-dist && del-cli --force .angular && del-cli --force package-lock.json && del-cli --force node_modules",
    "util:delete-dist": "del-cli --force dist/",
    "util:wait-and-start-demo": "wait-on dist/lux-components-lib/types/ihk-gfi-lux-components.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-accordion-aria.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-chat.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-conditional.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-file-preview.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-html.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-leave-guard.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-list-select.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-loading.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-markdown.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-min-max-input.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-paginator.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-skeleton.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-snackbar.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-lux-quill.d.ts dist/lux-components-lib/types/ihk-gfi-lux-components-test-utils.d.ts dist/theme/prebuilt-themes/luxtheme-authentic.css && npm run start",
    "vrt": "node scripts/vrt.js",
    "vrt:build": "npm run pack:theme && npm run pack:components && npm run pack:demo",
    "vrt:update": "node scripts/vrt.js --update-snapshots",
    "vrt:report": "npm install --prefix e2e --no-audit --no-fund && npm run report --prefix e2e",
    "watch:components": "npm run watch lux-components-lib",
    "watch:theme": "npm run watch --workspace=projects/lux-components-theme",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html,scss,json}": "prettier --write"
  },
  "workspaces": [
    "projects/*"
  ],
  "private": false,
  "dependencies": {
    "@angular/aria": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@ihk-gfi/lux-components-icons-and-fonts": "1.11.0",
    "@ihk-gfi/lux-components-theme": "21.11.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-locale": "^8.4.0",
    "dompurify": "~3.4.18",
    "marked": "~18.2.1",
    "ngx-cookie-service": "^22.2.0",
    "quill": "~2.0.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "uuid": "~14.0.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^3.0.0",
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular-devkit/core": "^22.0.3",
    "@angular-devkit/schematics": "^22.0.3",
    "@angular-devkit/schematics-cli": "^21.2.26",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/angular-vite": "^10.6.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.0.0",
    "axe-core": "^4.14.0",
    "del-cli": "^6.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "ng-packagr": "^22.2.6",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.13.0",
    "prettier": "3.10.1",
    "sass": "~1.104.1",
    "storybook": "^10.6.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "//": [
    "allowScripts: Freigabe der Install-Skripte (npm >= 11.20, sonst Warnung 'install-scripts'; künftig blockiert).",
    "Alle vier kommen aus der Angular-Build-Toolchain (@angular/build, ng-packagr, sass, vite): esbuild lädt die native Binary,",
    "@parcel/watcher, lmdb und msgpackr-extract bauen native Module nur, falls keine fertige Binary passt.",
    "Freigabe nur über den Namen (--no-allow-scripts-pin), damit Angular-Updates keine neue Freigabe erfordern."
  ],
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
